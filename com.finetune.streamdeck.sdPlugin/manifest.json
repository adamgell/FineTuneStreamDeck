{
  "UUID": "com.finetune.streamdeck",
  "Name": "FineTune",
  "Description": "Complete local FineTune audio control, live feedback and shared Stream Deck profiles. Requires the FineTune automation API.",
  "Author": "Adam Gell",
  "Version": "0.1.0.0",
  "SDKVersion": 3,
  "CodePath": "bin/plugin.js",
  "Icon": "imgs/plugin",
  "Category": "FineTune",
  "CategoryIcon": "imgs/category",
  "URL": "https://github.com/ronitsingh10/FineTune",
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "15.4"
    }
  ],
  "Nodejs": {
    "Version": "24"
  },
  "PropertyInspectorPath": "ui/index.html",
  "Actions": [
    {
      "UUID": "com.finetune.streamdeck.command",
      "Name": "FineTune Command",
      "Icon": "imgs/action",
      "Tooltip": "FineTune Command using FineTune automation.",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "States": [
        {
          "Image": "imgs/action",
          "TitleAlignment": "middle",
          "FontSize": 12
        },
        {
          "Image": "imgs/muted",
          "TitleAlignment": "middle",
          "FontSize": 12
        }
      ],
      "Encoder": {
        "layout": "$B1",
        "TriggerDescription": {
          "Rotate": "Adjust value",
          "Push": "Toggle mute (volume controls)",
          "Touch": "Toggle mute (volume controls)"
        }
      }
    },
